{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS5351 Tangentry requirements registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "scope", "baseline_commit", "requirements"],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["draft", "approved"]},
    "scope": {"type": "string", "minLength": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "note": {"type": "string"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "owner", "approval", "priority", "source", "statement", "fit", "tradeoff"],
        "properties": {
          "id": {"type": "string", "pattern": "^(FR|NFR|INV)-[0-9]{2,}$"},
          "type": {"enum": ["functional", "nonfunctional", "invariant"]},
          "owner": {"type": "string", "minLength": 1},
          "approval": {"enum": ["pending", "approved", "rejected"]},
          "priority": {"enum": ["Must", "Should", "Could", "Wont"]},
          "source": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "related": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "statement": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "threshold": {"type": "number", "minimum": 0},
          "method": {"type": "string", "minLength": 1},
          "fit": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "scenario", "expected", "test"],
              "properties": {
                "id": {"type": "string", "pattern": "^AC-(FR|NFR|INV)-[0-9]{2,}-[0-9]+$"},
                "scenario": {"type": "string", "minLength": 1},
                "expected": {"type": "string", "minLength": 1},
                "test": {"type": "string", "minLength": 1}
              }
            }
          },
          "tradeoff": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "nonfunctional"}}},
            "then": {"required": ["metric", "threshold", "method"]}
          }
        ]
      }
    }
  }
}